# Discord bot (NO exponer al frontend)
DISCORD_TOKEN=
# Discord OAuth2 para login del panel
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Allowlist de admins (IDs de Discord separados por coma)
ADMIN_DISCORD_IDS=
# Sesiones
SESSION_SECRET=cambia-esto-en-produccion-min-32-chars
# Postgres (cualquier versión >= 12; IDs UUIDv7 generados en app.
# Sin Docker: usa tu Postgres local o un servicio cloud)
DATABASE_URL=postgres://zyntra:zyntra@localhost:5432/zyntra
# Server
PORT=3000
# Omite el check de "admin del servidor" al elegir servidor: cualquiera en
# ADMIN_DISCORD_IDS puede configurar el bot para servidores donde no es
# admin. Úsalo solo con gente de total confianza.
BYPASS_ADMIN_SERVER_CHECK=false
# Bot config defaults
BOT_PREFIX=!
