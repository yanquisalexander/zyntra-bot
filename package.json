{
  "name": "zyntra-bot",
  "version": "1.0.0",
  "description": "Self-hosted Discord bot platform with web panel and JS plugin system",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --exclude \"data/**\" --exclude \"dist/**\" src/server/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "dev:all": "concurrently -n api,web -c blue,green \"pnpm dev\" \"pnpm dev:web\"",
    "start": "cross-env NODE_ENV=production tsx src/server/index.ts",
    "build": "vite build --config vite.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.13.1",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@mlc-ai/web-llm": "^0.2.86",
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-signature": "^1.2.2",
    "cron-parser": "^5.10.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.56.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-signature": "^1.1.2",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
